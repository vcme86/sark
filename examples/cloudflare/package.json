{
  "name": "sark-example-cloudflare",
  "version": "0.1.0",
  "private": true,
  "description": "Sark example for Cloudflare Workers, D1, R2, and Cron Triggers",
  "type": "module",
  "scripts": {
    "dev": "sark dev",
    "build": "sark build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB",
    "types": "wrangler types .build/worker-configuration.d.ts --include-runtime=false",
    "typecheck": "sark generate && pnpm types && tsc"
  },
  "dependencies": {
    "@olivaw/sark": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "wrangler": "^4.159.0"
  }
}
